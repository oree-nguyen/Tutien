    "assets:rig": "node tools/rig-full-resolution.mjs",
    "test:rig:structure": "node tools/rig-verify-fullres.mjs",
    "test:rig:browser": "node tools/rig/validate-browser.mjs",
    "test:rig:grip": "node tools/rig/solve-grips.mjs",
    "test:rig:joints": "node tools/rig/validate-joints.mjs",
    "test:rig:skin": "node tools/rig/validate-skin.mjs",
    "test:rig:contact": "node tools/rig/preview-grips.mjs",
    "test:rig:mesh-contact": "node tools/rig/validate-mesh-contact.mjs",
    "test:rig:reference-strain": "node tools/rig/validate-reference-strain.mjs",
